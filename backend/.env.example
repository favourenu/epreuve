# Copy this file to backend/.env and fill in your keys. Never commit .env.

# --- Security ---
# Signs session cookies. Required: generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Set to true when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false

# --- Database ---
# Leave unset locally to use a SQLite file (backend/epreuve.db). In production use
# Postgres, e.g. Neon's free tier (copy its connection string; postgres:// is fine):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Web app ---
# Public URL of the site, used in email links. Production: https://epreuve.site
APP_BASE_URL=http://localhost:5173
# Production also needs: CORS_ORIGINS=["https://epreuve.site"] and SESSION_COOKIE_SECURE=true

# --- Email (Resend, https://resend.com) ---
# Without a key, emails (e.g. password resets) are printed to the server log instead.
RESEND_API_KEY=
EMAIL_FROM=Épreuve <noreply@epreuve.site>

# --- Admin and certification ---
# Accounts with these emails become admins (JSON list).
ADMIN_EMAILS=[]
# Certificate thresholds (percent) and the wait between certification attempts at one test.
CERTIFICATION_PASS_PERCENT=75
CERTIFICATION_DISTINCTION_PERCENT=90
CERTIFICATION_COOLDOWN_DAYS=7
# How long company invitation links stay valid.
INVITE_VALID_DAYS=14

# --- AI providers (tried in this order; unconfigured ones are skipped) ---
AI_PROVIDER_ORDER=["openrouter","gemini","ollama"]

# OpenRouter: https://openrouter.ai/keys. The free tier is about 50 requests/day,
# and this app uses 1 request per completed test.
# Free model names change; pick a current ":free" model at https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Tried in order when the main model is busy or unavailable.
OPENROUTER_FALLBACK_MODELS=["google/gemma-4-31b-it:free","nvidia/nemotron-3.5-lightning:free"]

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-flash-latest always points at Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest

# Ollama (local, unlimited, slow without a GPU)
OLLAMA_ENABLED=true
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=900
